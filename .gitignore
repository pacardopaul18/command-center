node_modules

# SvelteKit
/.svelte-kit
/build
.output

# Database snapshots. These are exports of the live database and can contain
# real client data, so they never go to the remote repository. Keep them local
# or move them somewhere private. See D39.
backups/

# Cloudflare / wrangler local state
.wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example

# Other adapters
.vercel
.netlify

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
*.log
npm-debug.log*

# Rendered screenshots from volume testing. Regenerable, and large.
shots/
test-results/
playwright-report/

# Local dev server log, an artifact of running the suite.
dev.out
remote.out
mirror-progress.log

# Real client data placed here by Paul for the crosswalk loader to read.
#
# Not committed. The crosswalk is loaded from disk at run time and the file is
# Paul's override path, so nothing needs it in version control, and putting
# fifty-five real client names, Asana gids and activity dates into a remote
# repository is a one-way step that has not been asked for.
docs/data/
