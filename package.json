{
  "name": "command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/wrap-worker.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate:local": "wrangler d1 migrations apply command-center-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply command-center-db --remote",
    "db:seed:local": "wrangler d1 execute command-center-db --local --file=./seed/dev-seed.sql",
    "dev": "vite dev",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "schema:check": "node scripts/schema-check.js --remote",
    "schema:check:local": "node scripts/schema-check.js --local",
    "seed:generate": "python seed/generate-volume.py > seed/volume-large.sql",
    "seed:load": "wrangler d1 execute command-center-db --local --file=./seed/volume-large.sql",
    "test": "node scripts/test-all.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fontsource/dm-mono": "^5.2.5",
    "@fontsource/dm-sans": "^5.2.5",
    "hono": "^4.9.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7",
    "wrangler": "^4.42.0"
  }
}
