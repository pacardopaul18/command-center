{
	"name": "command-center",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/wrap-worker.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate:local": "wrangler d1 migrations apply command-center-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply command-center-db --remote",
		"db:seed:local": "wrangler d1 execute command-center-db --local --file=./seed/dev-seed.sql"
	},
	"dependencies": {
		"@fontsource/dm-mono": "^5.2.5",
		"@fontsource/dm-sans": "^5.2.5",
		"hono": "^4.9.0",
		"marked": "^16.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260828.1",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.42.0",
		"esbuild": "^0.28.0"
	}
}
